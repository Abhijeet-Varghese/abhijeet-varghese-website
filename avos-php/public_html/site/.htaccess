# AV OS — generated at publish (do not edit)
Options -Indexes
ErrorDocument 404 /404.html

# Compress text at the edge; already-compressed media/fonts pass through.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header merge Vary "Accept-Encoding"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|avif|webp|jpe?g|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^story\.html/?$ /story/ [R=301,L]
  RewriteRule ^experience\.html/?$ /experience/ [R=301,L]
  RewriteRule ^case\-studies\.html/?$ /case-studies/ [R=301,L]
  RewriteRule ^portfolio\.html/?$ /portfolio/ [R=301,L]
  RewriteRule ^contact\.html/?$ /contact/ [R=301,L]
  RewriteRule ^insights\.html/?$ /insights/ [R=301,L]
  RewriteRule ^journal\.html/?$ /journal/ [R=301,L]
  RewriteRule ^for\-recruiters\.html/?$ /for-recruiters/ [R=301,L]
  RewriteRule ^consulting\.html/?$ /consulting/ [R=301,L]
  RewriteRule ^sitemap\.html/?$ /sitemap/ [R=301,L]
  RewriteRule ^privacy\-policy\.html/?$ /privacy-policy/ [R=301,L]
  RewriteRule ^terms\.html/?$ /terms/ [R=301,L]
  RewriteRule ^case\-study\-orange\-business\-new\-executive\-briefing\-center\.html/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^case\-study\-enterprise\-technology\-made\-understandable\.html/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^experience\-design\/orange\-business\-executive\-briefing\-center/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^experience\-design\/orange\-business\-executive\-briefing\-center\/index\.html/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^case\-study\-intuitive\-experiences\-for\-industrial\-environments\.html/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]
  RewriteRule ^case\-study\-immersive\-solutions\-for\-the\-indian\-army\.html/?$ /case-studies/indian-army/ [R=301,L]
  RewriteRule ^essay\-technology\-should\-feel\-human\.html/?$ /essays/technology-should-feel-human/ [R=301,L]
  RewriteRule ^essay\-ai\-isnt\-replacing\-creativity\.html/?$ /essays/ai-isnt-replacing-creativity/ [R=301,L]
  RewriteRule ^essay\-designing\-experiences\-people\-remember\.html/?$ /essays/designing-experiences-people-remember/ [R=301,L]
  RewriteRule ^essay\-why\-enterprise\-experiences\-fail\.html/?$ /essays/why-enterprise-experiences-fail/ [R=301,L]
  RewriteRule ^journal\-what\-a\-year\-of\-ai\-enabled\-production\-taught\-me\.html/?$ /journal/what-a-year-of-ai-enabled-production-taught-me/ [R=301,L]
  RewriteRule ^journal\-the\-experience\-centre\-as\-a\-strategic\-instrument\.html/?$ /journal/the-experience-centre-as-a-strategic-instrument/ [R=301,L]
</IfModule>
