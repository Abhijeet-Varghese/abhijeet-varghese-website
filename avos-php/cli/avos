#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * AV OS CLI (Phase 3A/3B).
 *
 *   php cli/avos migrate [--dry-run]   apply pending migrations
 *   php cli/avos status                migration ledger state
 *   php cli/avos rollback [--steps=N]  roll back using @DOWN sections
 *   php cli/avos fresh                 drop all tables, migrate, seed
 *   php cli/avos reset                 drop all tables only
 *   php cli/avos seed                  system seed data (idempotent)
 *   php cli/avos health                boot + database diagnostics
 *   php cli/avos schema:validate       compare DB against DATABASE-SCHEMA.md
 *
 * Destructive commands (fresh/reset) refuse to run in production.
 */

$appRoot = dirname(__DIR__);
require $appRoot . '/app/Autoloader.php';
AvOS\Autoloader::register($appRoot . '/app');

use AvOS\Bootstrap\Kernel;
use AvOS\Config\Environment;
use AvOS\Migration\MigrationRunner;
use AvOS\Migration\SystemSeeder;

$argvList = $argv ?? [];
$command  = $argvList[1] ?? 'help';
$flags    = array_slice($argvList, 2);
$hasFlag  = static fn(string $f): bool => in_array($f, $flags, true);
$flagVal  = static function (string $name, string $default) use ($flags): string {
    foreach ($flags as $f) {
        if (str_starts_with($f, "--{$name}=")) return substr($f, strlen($name) + 3);
    }
    return $default;
};

$kernel = Kernel::boot($appRoot, sendHeaders: false);
$db     = $kernel->db();
$runner = new MigrationRunner($db, $appRoot . '/database/next/migrations');

$isProd = $kernel->environment->isProduction();
$guardDestructive = static function (string $cmd) use ($isProd): void {
    if ($isProd) {
        fwrite(STDERR, "Refusing to run `{$cmd}` in production.\n");
        exit(1);
    }
};

// Amendment A17. Kernel::boot() already refuses an unsafe target, so reaching
// this point means the guard passed; schema-writing commands re-assert it
// anyway, because the cost of being wrong once is a polluted legacy database.
$targetGuard = new AvOS\Database\TargetGuard($kernel->config);
$guardTarget = static function (string $cmd) use ($targetGuard): void {
    try {
        $targetGuard->assertSafeTarget("`{$cmd}`");
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
};

$line = static fn(string $s = '') => print($s . PHP_EOL);

switch ($command) {
    case 'migrate': {
        $guardTarget('migrate');
        $dry = $hasFlag('--dry-run');
        $t0 = microtime(true);
        $r = $runner->migrate($dry);
        $line();
        foreach ($r['skipped'] as $s) $line("  skip    {$s}");
        foreach ($r['applied'] as $a) $line("  applied {$a}");
        if ($r['failed'] !== null) {
            $line();
            $line('  MIGRATION FAILED');
            foreach ($r['failed'] as $k => $v) $line("    {$k}: {$v}");
            $line();
            exit(1);
        }
        $ms = (int)round((microtime(true) - $t0) * 1000);
        $line();
        $line(sprintf('  %d applied · %d already present · %d ms%s',
            count($r['applied']), count($r['skipped']), $ms, $dry ? ' (dry run)' : ''));
        $line();
        break;
    }

    case 'status': {
        $rows = $runner->status();
        $line();
        $line(sprintf('  %-34s %-14s %s', 'MIGRATION', 'STATE', 'APPLIED AT'));
        $line('  ' . str_repeat('-', 74));
        $bad = 0;
        foreach ($rows as $r) {
            if (!in_array($r['state'], ['applied', 'pending'], true)) $bad++;
            $line(sprintf('  %-34s %-14s %s', $r['migration'], $r['state'], $r['applied_at'] ?? '—'));
        }
        $line('  ' . str_repeat('-', 74));
        $pending = count(array_filter($rows, static fn($r) => $r['state'] === 'pending'));
        $line(sprintf('  %d migrations · %d pending · %d problems', count($rows), $pending, $bad));
        $line();
        exit($bad > 0 ? 1 : 0);
    }

    case 'rollback': {
        $guardTarget('rollback');
        $guardDestructive('rollback');
        $steps = (int)$flagVal('steps', '1');
        $line();
        foreach ($runner->rollback($steps) as [$name, $outcome]) $line("  {$name}: {$outcome}");
        $line();
        break;
    }

    case 'reset': {
        $guardTarget('reset');
        $guardDestructive('reset');
        $n = $runner->dropAll();
        $line(PHP_EOL . "  dropped {$n} tables from `{$db->databaseName()}`" . PHP_EOL);
        break;
    }

    case 'fresh': {
        $guardTarget('fresh');
        $guardDestructive('fresh');
        $runner->createDatabaseIfMissing();
        $dropped = $runner->dropAll();
        $t0 = microtime(true);
        $r = $runner->migrate(false);
        if ($r['failed'] !== null) {
            $line(PHP_EOL . '  MIGRATION FAILED');
            foreach ($r['failed'] as $k => $v) $line("    {$k}: {$v}");
            exit(1);
        }
        $migrateMs = (int)round((microtime(true) - $t0) * 1000);
        $t1 = microtime(true);
        $seed = (new SystemSeeder($db))->run();
        $seedMs = (int)round((microtime(true) - $t1) * 1000);
        $tables = (int)$db->scalar(
            'SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=?', [$db->databaseName()]
        );
        $line();
        $line("  dropped     {$dropped} tables");
        $line('  applied     ' . count($r['applied']) . " migrations ({$migrateMs} ms)");
        $line("  seeded      {$seed['permissions']} permissions · {$seed['roles']} roles · "
            . "{$seed['settings']} settings · {$seed['navigation']} nav groups ({$seedMs} ms)");
        $line("  tables now  {$tables}");
        $line();
        break;
    }

    case 'seed': {
        $guardTarget('seed');
        $seed = (new SystemSeeder($db))->run();
        $line(PHP_EOL . '  seeded: ' . json_encode($seed) . PHP_EOL);
        break;
    }

    /**
     * db:verify — safe pre-migration diagnostics.
     *
     * Answers "is this the NEW database?" without printing a single reusable
     * value: identifiers are masked, secrets are booleans, and the two database
     * names are compared by fingerprint. Exit 1 when the target is not proven
     * safe, so it can gate a migration in a script.
     */
    case 'db:verify': {
        $report = $targetGuard->report();

        // The ledger check CREATES avos_migrations if it is missing, so it must
        // never run against a target that has not been proven safe.
        $ledger = ['inspected' => false, 'reason' => 'target not proven safe'];
        if ($targetGuard->isSafe()) try {
            $ledger = ['inspected' => true, 'ledger_table_exists' => false, 'applied' => 0, 'pending' => 0, 'problems' => 0];
            $rows = $runner->status();
            $ledger['ledger_table_exists'] = (int)$db->scalar(
                'SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=? AND TABLE_NAME=?',
                [$db->databaseName(), 'avos_migrations'],
            ) > 0;
            $ledger['applied']  = count(array_filter($rows, static fn($r) => $r['state'] === 'applied'));
            $ledger['pending']  = count(array_filter($rows, static fn($r) => $r['state'] === 'pending'));
            $ledger['problems'] = count(array_filter($rows, static fn($r) => !in_array($r['state'], ['applied', 'pending'], true)));
            $ledger['tables_present'] = (int)$db->scalar(
                'SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=?', [$db->databaseName()]
            );
        } catch (Throwable $e) {
            $ledger['error'] = 'ledger unreadable: ' . $e->getCode();
        }

        $health = $db->health();
        $report['database_reachable'] = (bool)($health['ok'] ?? false);
        $report['migration_ledger']   = $ledger;

        $line(PHP_EOL . json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL);

        if ($report['verdict'] !== AvOS\Database\TargetGuard::OK) {
            fwrite(STDERR, "TARGET NOT SAFE: {$report['verdict']} — do not migrate.\n");
            exit(1);
        }
        if (!$report['database_reachable']) {
            fwrite(STDERR, "Database unreachable.\n");
            exit(1);
        }
        $line('  VERDICT: safe to migrate — target is the new database, not the legacy one.' . PHP_EOL);
        exit(0);
    }

    case 'health': {
        $status = $kernel->safeStatus();
        $line(PHP_EOL . json_encode($status, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL);
        exit($status['database']['ok'] ? 0 : 1);
    }

    case 'schema:validate': {
        require $appRoot . '/app/Migration/SchemaValidator.php';
        $report = (new AvOS\Migration\SchemaValidator($db, $appRoot . '/database/next/migrations'))->validate();
        $line();
        $line("  tables expected: {$report['expected_tables']} · present: {$report['present_tables']}");
        foreach (['missing_tables', 'unexpected_tables', 'missing_columns', 'missing_indexes'] as $k) {
            $items = $report[$k];
            $line(sprintf('  %-20s %d%s', $k, count($items), $items ? ': ' . implode(', ', array_slice($items, 0, 8)) : ''));
        }
        $line();
        exit($report['ok'] ? 0 : 1);
    }

    /**
     * owner:init — create the FIRST owner account.
     *
     * A migrated + seeded database has roles and permissions but no users, so
     * nothing can log in. The address is never an argument (it comes from the
     * configured owner identity) and the password is never an argument either —
     * it is read from the terminal with echo disabled, so neither value can
     * reach argv, shell history, a process list or a log.
     */
    case 'owner:init': {
        $guardTarget('owner:init');
        $bootstrap = new AvOS\Identity\OwnerBootstrap(
            new AvOS\Identity\UserRepository($db, new AvOS\Auth\PasswordHasher()),
            AvOS\Identity\EmailIdentity::fromConfig($kernel->config),
        );

        $state = $bootstrap->status();
        $line();
        $line('  owner address configured : ' . ($state['owner_address_configured'] ? 'yes' : 'NO'));
        $line('  owner account exists     : ' . ($state['owner_account_exists'] ? 'yes' : 'no'));
        $line('  active users             : ' . $state['user_count']);
        $line();

        if ($hasFlag('--status')) exit(0);

        if (!$state['owner_address_configured']) {
            fwrite(STDERR, "Set AV_OWNER_EMAIL (or \$ownerEmail in the private config) first.\n");
            exit(1);
        }
        if ($state['owner_account_exists']) {
            fwrite(STDERR, "An owner account already exists. This command creates the first one only.\n");
            exit(1);
        }
        if (!stream_isatty(STDIN)) {
            fwrite(STDERR, "Refusing to read a password from a pipe. Run this in an interactive shell.\n");
            exit(1);
        }

        $prompt = static function (string $label): string {
            fwrite(STDOUT, $label);
            $hidden = @shell_exec('stty -echo 2>/dev/null; echo ok') !== null;
            $value = rtrim((string)fgets(STDIN), "\r\n");
            if ($hidden) { @shell_exec('stty echo 2>/dev/null'); fwrite(STDOUT, PHP_EOL); }
            return $value;
        };

        $pw1 = $prompt('  owner password        : ');
        $pw2 = $prompt('  repeat password       : ');
        if ($pw1 === '' || $pw1 !== $pw2) {
            fwrite(STDERR, "Passwords did not match. Nothing was created.\n");
            exit(1);
        }

        try {
            $result = $bootstrap->create($flagVal('name', 'Owner'), $pw1);
        } catch (Throwable $e) {
            // The identity is redacted defensively: a validation message can
            // echo the address back ("is already registered").
            fwrite(STDERR, AvOS\Identity\EmailIdentity::fromConfig($kernel->config)->redact($e->getMessage()) . "\n");
            exit(1);
        } finally {
            $pw1 = $pw2 = str_repeat("\0", 64);
        }

        $line('  ' . json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        $line();
        break;
    }

    default:
        $line();
        $line('  AV OS CLI');
        $line('    migrate [--dry-run] · status · rollback [--steps=N]');
        $line('    fresh · reset · seed · health · schema:validate');
        $line('    db:verify                             safe pre-migration target check');
        $line('    owner:init [--status] [--name=NAME]   first owner account');
        $line();
        $line('  environment: ' . $kernel->environment->name());
        $line();
}
