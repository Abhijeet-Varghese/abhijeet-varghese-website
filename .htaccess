Options -Indexes
DirectoryIndex disabled

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

RewriteEngine On
RewriteRule ^avos-php(?:/|$) - [F,END]
RewriteRule ^ avos-php/router.php [END,QSA]

# Resume migration: preserve legacy URL while serving the latest file under its exact filename.
RewriteRule ^assets/Abhijeet-Varghese-Resume\.pdf$ /assets/Abhijeet_Varghese_Creative_Head_Resume.pdf [R=301,L]
