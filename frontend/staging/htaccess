# ============================================================================
# AV OS — staging web-root .htaccess (flat React/Vite + PHP backend)
#
# This is the .htaccess for the STAGING web root, e.g. /public_html/next/ for
# next.abhijeetvarghese.com. It serves the flat React/Vite build (index.html +
# hashed assets at the web root — NOT nested under site/) AND the PHP backend
# (admin/, api/, media.php), while keeping private files unreachable.
#
# PRIVATE files (backend/, includes/, database/, storage/, site-template/,
# config.local.php) must live OUTSIDE the web root (account root). The rules
# below are belt-and-suspenders in case any private file lands in the web root.
# ============================================================================

Options -Indexes
ErrorDocument 404 /404.html

# Clean URLs are canonical WITHOUT a trailing slash (§30). mod_dir would
# otherwise 301 /story → /story/ for every directory-backed page, contradicting
# the canonical and adding a redirect hop to every navigation.
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html index.php
</IfModule>

# ---------------------------------------------------------------------------
# 1) HARDENING — never expose .git, dotfiles, config, SQL, dumps, source
# ---------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|sql\.gz|md|lock|log|bak|backup|old|orig|save|swp|tmp|sh|bash|env|example|py|dist|ini|yml|yaml|tpl|twig|sqlite|sqlite3|db|dump|tar|tgz|gz|zip|rar|7z|pem|key|crt|p12|pfx|ts|tsx|map)$">
  Require all denied
</FilesMatch>

# Build/manifest and dependency metadata must never be served (§88 §4).
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|yarn\.lock|tsconfig.*\.json|vite\.config\..*|Dockerfile|Makefile|\.htpasswd|config.*\.php|.*\.local\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # block private paths if they ever land inside the web root
  RewriteRule ^(?:backend|includes|storage|database|installer|install-data|site-template|avos-private|private|backups|logs|tests|docs|scripts|node_modules|src|\.git|\.github|\.vscode|vendor)/ - [F,L]
  RewriteCond %{REQUEST_URI} (^|/)(config\.local\.php|config\.php|schema\.sql|provision\.sql|seed\.php|bootstrap\.php|site\.json|migrated-content\.json|\.env.*|\.gitignore|\.htpasswd)$ [NC]
  RewriteRule ^ - [F,L]

  # Deny any dotfile path segment (e.g. /.git/config, /foo/.env)
  RewriteCond %{REQUEST_URI} (^|/)\.[^/]+ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2) SECURITY HEADERS
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# 3) ROUTING — static React/Vite (flat) + PHP endpoints, without swallowing
#    /api/*, /admin/*, /install/*, /media/*
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

    # /api/v1/* → the NEW AV OS API front controller (Phase 3D–3F).
    #
    # LITESPEED NOTE — verified on the real host, not assumed. The first version
    # of this rule was:
    #
    #     RewriteCond %{REQUEST_URI} !^/api/v1/index\.php$
    #     RewriteRule ^api/v1(?:/.*)?$ api/v1/index.php [L,QSA]
    #
    # LiteSpeed silently did not match it, while every other rewrite in this
    # file worked (/story.html → 301, /media/* → media.php, /admin → login.php,
    # /backend/ → 403). The non-capturing optional group `(?:/.*)?` is not
    # handled the way Apache handles it. Rewritten below in the same simple
    # shape as the rules that demonstrably work on this host.
    #
    # The `!-f` guard means api/v1/index.php is served directly as a real file,
    # so the rewrite cannot re-enter and loop. REQUEST_URI is preserved, which
    # is what the router reads, so path parameters survive.
    #
    # The legacy unversioned /api/* surface is untouched and still served by
    # api/index.php.
    RewriteRule ^api/v1$ api/v1/index.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/v1/(.*)$ api/v1/index.php [L,QSA]

    # /media/* → private-storage media server
    RewriteRule ^media/(.+)$ media.php?f=$1 [L,QSA]

  # /admin and /admin/ → admin login (admin has no directory index)
  RewriteRule ^admin/?$ admin/login.php [L]

  # /install and /install/ → install wizard
  RewriteRule ^install/?$ install/index.php [L]

  # The React/Vite build is a real MPA: every page is a physical .html file.
  # No SPA fallback — unknown paths fall through to the designed 404.

  # legacy case-study redirect (preserved from production)
  RewriteRule ^case\-study\-enterprise\-technology\-made\-understandable\.html/?$ /experience-design/orange-business-executive-briefing-center/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 4) CACHE / COMPRESSION
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header merge Vary "Accept-Encoding"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|avif|webp|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
