{
  "name": "abhijeet-varghese-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React + Vite + TypeScript homepage migration for abhijeetvarghese.com",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts scripts/validate-homepage.mjs scripts/mobile-scroll-regression.mjs scripts/homepage-parity-regression.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate:home": "node scripts/validate-homepage.mjs",
    "test:smoke": "tsx scripts/smoke-homepage.tsx",
    "test:mobile-scroll": "node scripts/mobile-scroll-regression.mjs",
    "test:homepage-parity": "node scripts/homepage-parity-regression.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "playwright-core": "1.63.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.14"
  }
}
