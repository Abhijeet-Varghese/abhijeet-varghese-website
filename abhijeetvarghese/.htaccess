# abhijeetvarghese.com — static frontend (hand-authored; deployed as-is to the web root).
# Keep in sync with avos-php/public_html/.htaccess when AV OS shares the same web root.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /502.html
ErrorDocument 503 /503.html
ErrorDocument 504 /504.html

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset X-Powered-By
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header merge Vary "Accept-Encoding"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|avif|webp|jpe?g|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Clean error routes -> their designed HTML documents.
  RewriteRule ^403/?$ 403.html [L]
  RewriteRule ^404/?$ 404.html [L]
  RewriteRule ^500/?$ 500.html [L]
  RewriteRule ^502/?$ 502.html [L]
  RewriteRule ^503/?$ 503.html [L]
  RewriteRule ^504/?$ 504.html [L]
  RewriteRule ^maintenance/?$ maintenance.html [L]
  RewriteRule ^offline/?$ offline.html [L]

  # Assets referenced by root-level pages after clean-URL canonicalization.
  RewriteRule ^([^/]+)/(assets|css|js)/(.*)$ $2/$3 [L]
  RewriteRule ^([^/]+)/(manifest\.webmanifest|robots\.txt|sitemap\.xml)$ $2 [L]

  # Relative navigation accidentally nested under a clean URL.
  RewriteRule ^([^/]+)/(story|experience|case-studies|portfolio|contact|recruiter|consulting|insights|journal|sitemap|privacy|terms)\.html$ /$2/ [R=301,L,NE]
  RewriteRule ^([^/]+)/(story|experience|case-studies|portfolio|contact|recruiter|consulting|insights|journal|sitemap|privacy|terms)(/.*)?$ /$2$3 [R=301,L,NE]

  # Canonical home URL — only redirect when the browser explicitly requested index.html.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
  RewriteRule ^index\.html/?$ / [R=301,L]

  # Canonical standalone .html URLs — only redirect direct browser requests.
  # This prevents an internal clean-URL rewrite (e.g. /story/ -> story.html)
  # from bouncing back to /story/ or into the 404 handler.
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.html(?:[?\s]|$) [NC]
  RewriteRule ^(.+)\.html/?$ /$1/ [R=301,L,NE]

  # Legacy case-study URLs.
  RewriteRule ^case-study-enterprise-technology-made-understandable/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^experience-design/orange-business-executive-briefing-center/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^case-study-intuitive-experiences-for-industrial-environments/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]
  RewriteRule ^case-study-immersive-solutions-for-the-indian-army/?$ /case-studies/indian-army/ [R=301,L]
  RewriteRule ^experience-design/bpcl-palakkad/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]

  # Clean root pages -> their authored HTML files.
  RewriteRule ^(story|portfolio|contact|recruiter|consulting|insights|journal|sitemap|privacy|terms)/?$ $1.html [L]

  # Other root-level HTML pages: clean URL -> matching authored .html file.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/.]+)/?$ $1.html [L]
</IfModule>
