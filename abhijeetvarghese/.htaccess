# abhijeetvarghese.com — static frontend (hand-authored; deployed as-is to the web root).
# Keep in sync with avos-php/public_html/.htaccess when AV OS shares the same web root.
Options -Indexes
# Custom AV error experiences — served with the correct status code.
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /502.html
ErrorDocument 503 /503.html
ErrorDocument 504 /504.html

# Compress text at the edge; already-compressed media/fonts pass through.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header merge Vary "Accept-Encoding"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|avif|webp|jpe?g|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Custom AV error experiences (clean routes -> .html pages)
  RewriteRule ^403/?$ /403.html [L]
  RewriteRule ^404/?$ /404.html [L]
  RewriteRule ^500/?$ /500.html [L]
  RewriteRule ^502/?$ /502.html [L]
  RewriteRule ^503/?$ /503.html [L]
  RewriteRule ^504/?$ /504.html [L]
  RewriteRule ^maintenance/?$ /maintenance.html [L]
  RewriteRule ^offline/?$ /offline.html [L]

  # --- Maintenance mode (Apache, one-time set-up) -------------------------
  # The AV router honours AV_MAINTENANCE=1 / storage/maintenance.lock, but on a
  # pure static Apache host you can instead serve the maintenance screen for
  # every request by uncommenting the block below. Remove it to go live again.
  # RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  # RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  # RewriteCond %{REQUEST_URI} !^/css/ [NC]
  # RewriteCond %{REQUEST_URI} !^/js/ [NC]
  # RewriteCond %{REQUEST_URI} !sw\.js [NC]
  # RewriteRule ^.*$ /maintenance.html [L]

  # Case Studies + Experience clean URLs (legacy flat pages -> canonical directories)
  RewriteRule ^case-studies\.html/?$ /case-studies/ [R=301,L]
  RewriteRule ^experience\.html/?$ /experience/ [R=301,L]
  # Legacy case-study pages -> canonical clean URLs (no chains)
  RewriteRule ^case-study-enterprise-technology-made-understandable\.html/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^experience-design/orange-business-executive-briefing-center/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^case-study-intuitive-experiences-for-industrial-environments\.html/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]
  RewriteRule ^case-study-immersive-solutions-for-the-indian-army\.html/?$ /case-studies/indian-army/ [R=301,L]
  RewriteRule ^experience-design/bpcl-palakkad/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]
</IfModule>
