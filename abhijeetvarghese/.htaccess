# abhijeetvarghese.com — static frontend (hand-authored; deployed as-is to the web root).
# Keep in sync with avos-php/public_html/.htaccess when AV OS shares the same web root.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /502.html
ErrorDocument 503 /503.html
ErrorDocument 504 /504.html

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset X-Powered-By
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.emailjs.com; media-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header merge Vary "Accept-Encoding"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|avif|webp|jpe?g|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Designed AV error experiences. END prevents redirect loops.
  RewriteRule ^403/?$ /403.html [END]
  RewriteRule ^404/?$ /404.html [END]
  RewriteRule ^500/?$ /500.html [END]
  RewriteRule ^502/?$ /502.html [END]
  RewriteRule ^503/?$ /503.html [END]
  RewriteRule ^504/?$ /504.html [END]
  RewriteRule ^maintenance/?$ /maintenance.html [END]
  RewriteRule ^offline/?$ /offline.html [END]

  # --- rescue rules for still-cached pre-canonicalization HTML -------------
  # (old pages used relative refs; these keep them alive until caches drain)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$2/$3 -f
  RewriteRule ^([^/]+)/(assets|css|js)/(.*)$ /$2/$3 [END]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$2 -f
  RewriteRule ^([^/]+)/(manifest\.webmanifest|robots\.txt|sitemap\.xml)$ /$2 [END]
  RewriteRule ^([^/]+)/(story|experience|case-studies|portfolio|contact|recruiter|consulting|insights|journal|sitemap|privacy|terms)\.html$ /$2/ [R=301,L,NE]
  RewriteRule ^([^/]+)/(story|experience|case-studies|portfolio|contact|recruiter|consulting|insights|journal|sitemap|privacy|terms)(/.*)?$ /$2$3 [R=301,L,NE]

  # --- legacy destinations & aliases (no chains) ----------------------------
  RewriteRule ^case-studies\.html/?$ /case-studies/ [R=301,L]
  RewriteRule ^experience\.html/?$ /experience/ [R=301,L]
  RewriteRule ^recruitment/?$ /recruiter/ [R=301,L]
  RewriteRule ^case-study-enterprise-technology-made-understandable\.html/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^case-study-enterprise-technology-made-understandable/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^experience-design/orange-business-executive-briefing-center/?$ /case-studies/orange-business/ [R=301,L]
  RewriteRule ^case-study-intuitive-experiences-for-industrial-environments\.html/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]
  RewriteRule ^case-study-intuitive-experiences-for-industrial-environments/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]
  RewriteRule ^case-study-immersive-solutions-for-the-indian-army\.html/?$ /case-studies/indian-army/ [R=301,L]
  RewriteRule ^case-study-immersive-solutions-for-the-indian-army/?$ /case-studies/indian-army/ [R=301,L]
  RewriteRule ^experience-design/bpcl-palakkad/?$ /case-studies/bharat-petroleum-corporation-limited/ [R=301,L]

  # Insight 03 moved to its canonical insights URL.
  RewriteRule ^essay-designing-experiences-people-remember(?:\.html)?/?$ /insights/designing-experiences-people-remember/ [R=301,L]
RewriteRule ^essay-ai-isnt-replacing-creativity(?:\.html)?/?$ /insights/ai-isnt-replacing-creativity/ [R=301,L]
RewriteRule ^essay-technology-should-feel-human(?:\.html)?/?$ /insights/technology-should-feel-human/ [R=301,L]
RewriteRule ^essay-why-enterprise-experiences-fail(?:\.html)?/?$ /insights/why-enterprise-experiences-fail/ [R=301,L]

  # --- generic clean-URL engine (mirrors avos-php/router.php) ---------------
  # Canonical form: every page lives at exactly ONE url — /section/ for
  # directories, /name/ for single pages. Everything else 301s here.
  # /index.html, /index, /any/dir/index, /any/dir/index.html -> directory root
  # (THE_REQUEST = the raw client request line — beats LiteSpeed/Apache
  # directory canonicalization on real directories)
  RewriteCond %{THE_REQUEST}\s/([^?\ ]*?)index(\.html)?/?[?\ ]
  RewriteRule ^ /%1/ [R=301,L,NE]
  RewriteRule ^index(\.html)?/?$ / [R=301,L]
  RewriteRule ^(.+/)index(\.html)?/?$ /$1 [R=301,L]
  # /page.html or stray /page.html/ -> /page/
  RewriteRule ^(.+)\.html/?$ /$1/ [R=301,L]
  # /page (no slash) -> /page/  (only when page.html exists)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
  # /page/ -> serve page.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ $1.html [END]
</IfModule>
